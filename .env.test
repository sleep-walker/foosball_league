SECRET_KEY=test-secret-not-for-production
ASYNC_DATABASE_URL=sqlite+aiosqlite:///:memory:?cache=shared
TOKEN_LIFETIME=3600
DEBUG=true
# The API returns 403 for unverified users, so the integration tests (which
# register users on the fly) need auto-verification.  Previously this was only
# set in the developer's untracked .env, which made the suite pass locally and
# fail on a clean checkout / in CI with 46 x "403 Forbidden".
AUTO_VERIFY_USERS=true
